<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/margen_pantalla">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/tam_logo"
                android:layout_height="@dimen/tam_logo"
                android:contentDescription="@string/desc_logo"
                android:src="@drawable/ic_mancuerna" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_elemento"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    style="@style/EstiloTitulo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lema"
                    style="@style/EstiloTextoSecundario" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_foto"
            android:layout_marginTop="@dimen/margen_elemento"
            android:contentDescription="@string/desc_foto"
            android:scaleType="centerCrop"
            android:src="@drawable/img_fondo_gimnasio" />

        <TextView
            android:id="@+id/txtEntrenoHoy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_elemento"
            android:text="@string/entreno_hoy"
            style="@style/EstiloTitulo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_elemento"
            android:text="@string/titulo_ejercicios"
            style="@style/EstiloTextoSecundario" />

        <ListView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:entries="@array/ejercicios_tren_superior" />

        <Button
            android:id="@+id/btnEmpezar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/boton_empezar"
            style="@style/EstiloBoton" />
    </LinearLayout>
</FrameLayout>